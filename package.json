  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
