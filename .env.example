# HumanTextSuite - Configuration
VITE_APP_ENV=development
VITE_APP_TITLE="HumanTextSuite - Detector & Humanizador IA"

# Umbrales de Detección (%)
VITE_THRESHOLD_HUMAN_MAX=35
VITE_THRESHOLD_AI_MIN=70

# Parámetros del Motor Estadístico
VITE_PERPLEXITY_WEIGHT=0.40
VITE_BURSTINESS_WEIGHT=0.35
VITE_CLICHE_WEIGHT=0.25

# Límites de Procesamiento
VITE_MAX_TEXT_LENGTH=50000
VITE_DEFAULT_ANALYSIS_TIMEOUT_MS=10000

# API / Integración opcional de modelos externos (opcional)
VITE_AI_MODEL_PROVIDER=heuristic_local
VITE_AI_API_KEY=
